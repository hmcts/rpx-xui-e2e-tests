{
  "name": "rpx-xui-e2e-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.1"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "pwinstall": "./node_modules/.bin/playwright install --with-deps chromium",
    "test:setup:playwright-install-chromium": "./node_modules/.bin/playwright install chromium",
    "setup": "yarn install --immutable && yarn pwinstall",
    "get-secrets": "node ./node_modules/@hmcts/playwright-common/dist/scripts/get-secrets.js",
    "env:populate": "bash ./scripts/populate-env-from-keyvault.sh",
    "env:populate:aat": "bash ./scripts/populate-env-from-keyvault.sh aat",
    "env:populate:demo": "bash ./scripts/populate-env-from-keyvault.sh demo",
    "env:populate:playwright": "bash ./scripts/populate-playwright-env-from-keyvault.sh",
    "env:populate:playwright:aat": "bash ./scripts/populate-playwright-env-from-keyvault.sh aat",
    "env:populate:playwright:demo": "bash ./scripts/populate-playwright-env-from-keyvault.sh demo",
    "lint": "yarn harness:unit && node --test scripts/verify-playwright-pipeline.test.cjs && yarn tsc -p tsconfig.json && node ./node_modules/eslint/bin/eslint.js .",
    "ui:session": "node ./scripts/record-ui-session.mjs",
    "harness:local:shell": "node ./scripts/local-exui-static-proxy.mjs",
    "harness:manifest": "node ./scripts/check-exui-harness-manifest.mjs",
    "harness:catalogue": "node scripts/check-exui-configuration-catalogue.mjs",
    "harness:release-summary": "node ./scripts/write-exui-release-assurance-summary.mjs",
    "harness:defect-intake": "node ./scripts/classify-exui-defect-intake.mjs",
    "harness:local:prove": "node scripts/run-harness-local-poc.mjs --local",
    "harness:local:odhin": "node scripts/run-harness-local-poc.mjs --local --odhin",
    "harness:local:validate": "node scripts/run-harness-local-poc.mjs --manifest --lint",
    "harness:mutation:wa": "node ./scripts/run-harness-mutation-proof.mjs",
    "harness:mutation:civil": "EXUI_ASSURANCE_MUTATION=drop-civil-hearings-case-type node ./scripts/run-harness-mutation-proof.mjs",
    "harness:mutation:civil-event": "EXUI_ASSURANCE_MUTATION=drop-civil-create-claim-field node ./scripts/run-harness-mutation-proof.mjs",
    "harness:mutation:employment": "EXUI_ASSURANCE_MUTATION=drop-employment-service-code node ./scripts/run-harness-mutation-proof.mjs",
    "harness:mutation:ia": "EXUI_ASSURANCE_MUTATION=drop-ia-hearings-bail-case-type node ./scripts/run-harness-mutation-proof.mjs",
    "harness:mutation:probate": "EXUI_ASSURANCE_MUTATION=drop-probate-staff-family node ./scripts/run-harness-mutation-proof.mjs",
    "harness:mutation:st-cic": "EXUI_ASSURANCE_MUTATION=drop-st-cic-wa-family node ./scripts/run-harness-mutation-proof.mjs",
    "harness:mutation:ccd": "node ./scripts/run-harness-ccd-mutation-proof.mjs",
    "harness:demo": "node ./scripts/run-harness-local-demo.mjs",
    "harness:demo:keep": "node ./scripts/run-harness-local-demo.mjs --keep-running",
    "harness:demo:start": "node ./scripts/run-harness-local-demo.mjs --start-only",
    "harness:demo:exui4493": "node ./scripts/run-exui4493-toolkit-demo.mjs",
    "harness:local:exui4493:toolkit": "node scripts/run-harness-local-poc.mjs --selection=toolkit --odhin",
    "harness:unit": "node --test --test-concurrency=1 scripts/verify-harness-public-odhin.test.cjs scripts/verify-harness-local-aat.test.cjs scripts/verify-exui-definition-discovery.test.cjs scripts/verify-exui-release-evidence.test.cjs scripts/verify-exui-evidence-io.test.cjs scripts/verify-exui-catalogue.test.cjs scripts/verify-harness-runtime-safety.test.cjs scripts/verify-exui-candidate-artifact.test.cjs scripts/verify-exui-candidate-build.test.cjs scripts/verify-exui-oci-candidate.test.cjs scripts/verify-exui-oci-runtime.test.cjs scripts/verify-exui-candidate-runtime.test.cjs scripts/verify-exui-configuration-catalogue.test.cjs scripts/verify-exui-configuration-runtime-coverage.test.cjs scripts/verify-exui-external-evidence.test.cjs scripts/verify-exui-ccd-runtime.test.cjs scripts/verify-exui-ccd-browser-runtime.test.cjs scripts/verify-exui-candidate-ci.test.cjs scripts/verify-exui-native-isolation.test.cjs scripts/verify-exui-host-invocation.test.cjs scripts/verify-exui-routing-runtime.test.cjs scripts/verify-exui-deployment-profiles.test.cjs scripts/verify-exui-producer-finalization.test.cjs scripts/verify-exui-global-search-runtime.test.cjs scripts/verify-exui-private-evidence.test.cjs scripts/verify-exui-hearing-publication.test.cjs scripts/verify-exui-hearing-publication-proof.test.cjs scripts/verify-exui-hearing-publication-wiring.test.cjs",
    "harness:candidate:prepare": "node scripts/prepare-harness-candidate.mjs",
    "harness:candidate": "node scripts/run-harness-candidate.mjs",
    "harness:candidate:ci": "node scripts/run-harness-ci.mjs",
    "harness:candidate:oci": "node scripts/run-harness-oci-candidate.mjs",
    "harness:verify-gate": "node scripts/verify-exui-release-gate.mjs",
    "harness:ccd:start": "node scripts/start-harness-ccd.mjs",
    "harness:ccd:candidate": "node scripts/run-harness-ccd-candidate.mjs",
    "harness:diagnostic": "node scripts/run-harness-local-poc.mjs",
    "harness:aat": "node scripts/run-harness-local-poc.mjs --aat",
    "harness:ci": "node scripts/run-harness-local-poc.mjs --ci --odhin",
    "harness:diagnostic:ci": "node scripts/run-harness-local-poc.mjs --ci --odhin",
    "harness:diagnostic:environment": "node scripts/run-harness-local-poc.mjs --selection=environment",
    "harness:diagnostic:toolkit": "node scripts/run-harness-local-poc.mjs --selection=toolkit",
    "harness:support": "./node_modules/.bin/playwright test -c playwright.harness-support.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.0",
    "@faker-js/faker": "^10.0.0",
    "@hmcts/playwright-common": "^1.1.3",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "axe-core": "^4.11.1",
    "axe-html-reporter": "^2.2.11",
    "c8": "^12.0.0",
    "dotenv": "^18.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-playwright": "^2.1.0",
    "node-html-parser": "^9.0.0",
    "odhin-reports-playwright": "patch:odhin-reports-playwright@npm%3A1.1.8#~/.yarn/patches/odhin-reports-playwright-npm-1.1.8-a445ed88b7.patch",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.59.1",
    "uuid": "^14.0.0",
    "zod": "^4.0.0"
  }
}
