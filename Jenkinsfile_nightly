#!groovy

properties([
  pipelineTriggers([cron('05 17 * * 1-5')])
])

@Library('Infrastructure@2.8.0') _

// Product regression suites live with their product owner. This job runs only
// Harness supporting checks; it cannot issue native candidate/release approval.
def runHarnessSupportingChecks = {
  stage('Harness supporting checks — no release credit') {
    sh 'rm -f functional-output/tests/harness/public/release-assurance-summary.json'
    sh 'bash scripts/harness-jenkins-node.sh scripts/manage-harness-public-reports.cjs --reset'
    try {
      sh '''#!/usr/bin/env bash
set -e
export CI=true
export NVM_DIR='/home/jenkinsssh/.nvm'
source /opt/nvm/nvm.sh
nvm use
export PATH="$HOME/.local/bin:$PATH"
node -e 'const expected = require("node:fs").readFileSync(".nvmrc", "utf8").trim(); if (process.versions.node !== expected) { console.error("Node version does not match .nvmrc"); process.exit(1); } console.log("Harness Node: " + process.versions.node);'
expected_yarn="$(node -p 'require("./package.json").packageManager')"
actual_yarn="$(corepack yarn --version)"
if [ "yarn@$actual_yarn" != "$expected_yarn" ]; then
  echo 'Yarn version does not match packageManager' >&2
  exit 1
fi
echo "Harness Yarn: $actual_yarn"
corepack yarn test:setup:playwright-install-chromium && node scripts/verify-playwright-browsers.cjs chromium && corepack yarn harness:support && node scripts/manage-harness-public-reports.cjs --validate support && corepack yarn harness:diagnostic:ci && node scripts/manage-harness-public-reports.cjs --validate model
'''
    } finally {
      echo '[harness-report] Raw reports remain job-local; only validated summaries and safe Odhín reports may be published.'
      if (fileExists('functional-output/tests/harness/public/release-assurance-summary.json')) {
        sh 'bash scripts/harness-jenkins-node.sh scripts/write-exui-release-assurance-summary.mjs --validate-public-summary functional-output/tests/harness/public/release-assurance-summary.json'
        archiveArtifacts allowEmptyArchive: false, artifacts: 'functional-output/tests/harness/public/release-assurance-summary.json'
      }
      if (fileExists('functional-output/tests/harness/public/odhin-support/index.html')) {
        sh 'bash scripts/harness-jenkins-node.sh scripts/manage-harness-public-reports.cjs --validate support'
        archiveArtifacts allowEmptyArchive: false, artifacts: 'functional-output/tests/harness/public/odhin-support/index.html'
        publishHTML(target: [reportName: 'Harness support — Odhín (no release credit)',
          reportDir: 'functional-output/tests/harness/public/odhin-support', reportFiles: 'index.html',
          includes: 'index.html', keepAll: true, alwaysLinkToLastBuild: false, allowMissing: false])
      }
      if (fileExists('functional-output/tests/harness/public/odhin-model/index.html')) {
        sh 'bash scripts/harness-jenkins-node.sh scripts/manage-harness-public-reports.cjs --validate model'
        archiveArtifacts allowEmptyArchive: false, artifacts: 'functional-output/tests/harness/public/odhin-model/index.html'
        publishHTML(target: [reportName: 'Harness models — Odhín (no release credit)',
          reportDir: 'functional-output/tests/harness/public/odhin-model', reportFiles: 'index.html',
          includes: 'index.html', keepAll: true, alwaysLinkToLastBuild: false, allowMissing: false])
      }
    }
  }
}

withNightlyPipeline('nodejs', 'xui', 'xui-e2e-tests', 400) {
  enableSlackNotifications('#xui-pipeline')
  afterAlways('DependencyCheckNightly') { runHarnessSupportingChecks() }
}
