#!groovy

properties([
  pipelineTriggers([cron('05 17 * * 1-5')])
])

@Library('Infrastructure@2.8.0') _

// Product regression suites live with their product owner. This job runs only
// Harness supporting checks; it cannot issue native candidate/release approval.
def runHarnessSupportingChecks = {
  stage('Harness supporting checks — no release credit') {
    sh 'rm -f functional-output/tests/harness/public/release-assurance-summary.json'
    try {
      sh 'corepack yarn lint && corepack yarn test:setup:playwright-install-chromium && node scripts/verify-playwright-browsers.cjs chromium && corepack yarn harness:support && corepack yarn harness:diagnostic:ci'
    } finally {
      echo '[harness-report] Raw reports remain job-local; only a validated public summary may be archived.'
      if (fileExists('functional-output/tests/harness/public/release-assurance-summary.json')) {
        sh 'node scripts/write-exui-release-assurance-summary.mjs --validate-public-summary functional-output/tests/harness/public/release-assurance-summary.json'
        archiveArtifacts allowEmptyArchive: false, artifacts: 'functional-output/tests/harness/public/release-assurance-summary.json'
      }
    }
  }
}

withNightlyPipeline('nodejs', 'xui', 'xui-e2e-tests', 400) {
  enableSlackNotifications('#xui-pipeline')
  afterAlways('DependencyCheckNightly') { runHarnessSupportingChecks() }
}
