{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "playwright"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "playwright.config.ts",
    "playwright.harness.config.ts",
    "playwright.harness-diagnostic.config.ts",
    "playwright.harness-support.config.ts",
    "src/**/*.ts"
  ]
}
