#!groovy

properties([
  [$class: 'GithubProjectProperty', projectUrlStr: 'https://github.com/hmcts/rpx-xui-e2e-tests'],
  pipelineTriggers([[$class: 'GitHubPushTrigger']])
])

@Library('Infrastructure@2.8.0') _

// Product regression suites live with their product owner. This job runs
// Harness checks and bounded native candidate/CCD pilots; full release approval remains unavailable.
def runHarnessSupportingChecks = {
  stage('Harness assurance pilots — no full release approval') {
    sh 'rm -f functional-output/tests/harness/public/release-assurance-summary.json'
    sh 'bash scripts/harness-jenkins-node.sh scripts/manage-harness-public-reports.cjs --reset'
    sh 'bash scripts/harness-jenkins-node.sh scripts/observe-harness-worker.mjs --reset'
    try {
      sh '''#!/usr/bin/env bash
set -e
export CI=true
export NVM_DIR='/home/jenkinsssh/.nvm'
source /opt/nvm/nvm.sh
nvm use
export PATH="$HOME/.local/bin:$PATH"
node -e 'const expected = require("node:fs").readFileSync(".nvmrc", "utf8").trim(); if (process.versions.node !== expected) { console.error("Node version does not match .nvmrc"); process.exit(1); } console.log("Harness Node: " + process.versions.node);'
expected_yarn="$(node -p 'require("./package.json").packageManager')"
actual_yarn="$(corepack yarn --version)"
if [ "yarn@$actual_yarn" != "$expected_yarn" ]; then
  echo 'Yarn version does not match packageManager' >&2
  exit 1
fi
echo "Harness Yarn: $actual_yarn"
node scripts/observe-harness-worker.mjs
corepack yarn test:setup:playwright-install-chromium && node scripts/verify-playwright-browsers.cjs chromium && node scripts/run-harness-jenkins-assurance.mjs && node scripts/manage-harness-public-reports.cjs --validate
'''
    } finally {
      echo '[harness-report] Raw reports remain job-local; only validated summaries and safe Odhín reports may be published.'
      if (fileExists('functional-output/tests/harness/public/release-assurance-summary.json')) {
        sh 'bash scripts/harness-jenkins-node.sh scripts/write-exui-release-assurance-summary.mjs --validate-public-summary functional-output/tests/harness/public/release-assurance-summary.json'
        archiveArtifacts allowEmptyArchive: false, artifacts: 'functional-output/tests/harness/public/release-assurance-summary.json'
      }
      if (fileExists('functional-output/tests/harness/public/native-ci-capabilities.json')) {
        sh 'bash scripts/harness-jenkins-node.sh scripts/observe-harness-worker.mjs --validate'
        archiveArtifacts allowEmptyArchive: false, artifacts: 'functional-output/tests/harness/public/native-ci-capabilities.json'
      }
      if (fileExists('functional-output/tests/harness/public/odhin/index.html')) {
        sh 'bash scripts/harness-jenkins-node.sh scripts/manage-harness-public-reports.cjs --validate'
        archiveArtifacts allowEmptyArchive: false, artifacts: 'functional-output/tests/harness/public/odhin/index.html'
        publishHTML(target: [reportName: 'EXUI Assurance Harness',
          reportDir: 'functional-output/tests/harness/public/odhin', reportFiles: 'index.html',
          includes: 'index.html', keepAll: true, alwaysLinkToLastBuild: false, allowMissing: false])
      }
    }
  }
}

withNightlyPipeline('nodejs', 'xui', 'xui-e2e-tests', 600) {
  enableSlackNotifications('#xui-pipeline')
  onPR() {
    afterAlways('DependencyCheckNightly') { runHarnessSupportingChecks() }
  }
  onMaster() {
    afterAlways('DependencyCheckNightly') { runHarnessSupportingChecks() }
  }
}
